{
  "expo": {
    "name": "GoGo",
    "slug": "gogo",
    "version": "0.1.0",
    "scheme": "gogo",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "backgroundColor": "#F6F3EE",
    "splash": {
      "backgroundColor": "#F6F3EE",
      "resizeMode": "contain"
    },
    "ios": {
      "bundleIdentifier": "app.gogo.mobile",
      "supportsTablet": false,
      "associatedDomains": [
        "applinks:gogo.app"
      ]
    },
    "android": {
      "package": "app.gogo.mobile",
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "gogo.app",
              "pathPrefix": "/r"
            },
            {
              "scheme": "https",
              "host": "gogo.app",
              "pathPrefix": "/plans"
            },
            {
              "scheme": "https",
              "host": "gogo.app",
              "pathPrefix": "/places"
            },
            {
              "scheme": "https",
              "host": "gogo.app",
              "pathPrefix": "/room"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ]
    },
    "plugins": [
      "expo-router",
      "expo-dev-client",
      "expo-splash-screen",
      [
        "expo-image-picker",
        {
          "photosPermission": "GoGo cần truy cập thư viện ảnh để bạn thêm ảnh check-in tại địa điểm."
        }
      ],
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "GoGo dùng vị trí của bạn để gợi ý địa điểm gần đó. Bạn có thể chọn khu vực thủ công thay vì cấp quyền.",
          "locationWhenInUsePermission": "GoGo dùng vị trí của bạn để gợi ý địa điểm gần đó. Bạn có thể chọn khu vực thủ công thay vì cấp quyền.",
          "isIosBackgroundLocationEnabled": false,
          "isAndroidBackgroundLocationEnabled": false
        }
      ],
      "expo-secure-store"
    ]
  }
}
