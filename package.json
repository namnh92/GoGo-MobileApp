{
  "name": "gogo-mobile",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "packageManager": "pnpm@10.34.3",
  "scripts": {
    "start": "expo start --dev-client",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "lint": "expo lint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:contract": "GOGO_CONTRACT_TEST=1 vitest run src/shared/api/__tests__/contract.test.ts",
    "api:types": "openapi-typescript openapi/gogo.v1.yaml -o src/shared/api/schema.d.ts",
    "api:check": "openapi-typescript openapi/gogo.v1.yaml -o /tmp/gogo.mobile.v1.d.ts && diff -q /tmp/gogo.mobile.v1.d.ts src/shared/api/schema.d.ts",
    "test:ui": "jest",
    "test:all": "pnpm test && pnpm test:ui"
  },
  "dependencies": {
    "@callstack/liquid-glass": "^0.8.1",
    "@hookform/resolvers": "^5.9.1",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@tanstack/query-async-storage-persister": "^5.102.7",
    "@tanstack/react-query": "^5.102.5",
    "@tanstack/react-query-persist-client": "^5.102.7",
    "expo": "~54.0.37",
    "expo-blur": "~15.0.8",
    "expo-clipboard": "~8.0.8",
    "expo-constants": "~18.0.14",
    "expo-crypto": "~15.0.9",
    "expo-dev-client": "~6.0.21",
    "expo-haptics": "^15.0.8",
    "expo-image": "~3.0.11",
    "expo-image-picker": "~17.0.11",
    "expo-linear-gradient": "~15.0.8",
    "expo-linking": "~8.0.12",
    "expo-location": "~19.0.8",
    "expo-modules-core": "3.0.30",
    "expo-network": "~8.0.8",
    "expo-router": "~6.0.24",
    "expo-secure-store": "~15.0.8",
    "expo-splash-screen": "~31.0.13",
    "expo-status-bar": "~3.0.9",
    "expo-system-ui": "~6.0.9",
    "i18next": "^26.4.0",
    "onesignal-expo-plugin": "2.7.1",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-hook-form": "^7.86.0",
    "react-i18next": "^17.0.12",
    "react-native": "0.81.5",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-maps": "1.20.1",
    "react-native-onesignal": "5.5.9",
    "react-native-reanimated": "~4.1.7",
    "react-native-safe-area-context": "~5.6.2",
    "react-native-screens": "~4.16.0",
    "react-native-svg": "15.12.1",
    "react-native-tenjin": "1.6.0",
    "react-native-worklets": "0.5.1",
    "zod": "^4.4.3",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@testing-library/react-native": "^14.0.1",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.4.0",
    "@types/react": "^19.1.17",
    "eslint": "^9.39.5",
    "eslint-config-expo": "^57.0.1",
    "jest": "^29.7.0",
    "jest-environment-node": "^29.7.0",
    "jest-expo": "^57.0.5",
    "openapi-typescript": "^7.13.0",
    "test-renderer": "^1.2.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  },
  "expo": {
    "autolinking": {
      "nativeModulesDir": "./modules"
    }
  }
}
