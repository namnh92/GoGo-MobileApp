# GoGo Mobile environments — no secrets here, EXPO_PUBLIC_* only.
# Real secrets belong to the secret manager / EAS secrets, never this file.
# Cũng chọn flavour của bản build: dev | stag | prod
# → bundle id max.gogo.{flavor}, tên app và scheme tương ứng (app.config.ts).
EXPO_PUBLIC_ENV=dev
# DEV is remote-first: this points at the deployed dev API, not a backend on
# your machine. Running GoGo-BE, PostgreSQL and Redis locally is not required
# and not expected (GoGo-Infra INF-038).
#
# Override it only to test against a backend you are changing yourself.
EXPO_PUBLIC_API_URL=https://api-dev.gogo.id.vn/v1
# The share-link host for this environment, served by the gogo-dev-share-link
# Worker: /l/{slug} resolves and redirects, and /.well-known/* carries the app
# association files.
#
# gogo.app is not a domain this project owns, so a link built against it can
# never verify. The owned domain is gogo.id.vn; dev's share host is
# go-dev.gogo.id.vn.
EXPO_PUBLIC_WEB_BASE_URL=https://go-dev.gogo.id.vn
