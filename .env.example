# GoGo Mobile environments — no secrets here. EXPO_PUBLIC_* values only, plus an
# empty placeholder for the one build-time key at the bottom.
# Real secrets belong to the secret manager / EAS secrets, never this file.
# Cũng chọn flavour của bản build: dev | stag | prod
# → bundle id max.gogo.{flavor}, tên app và scheme tương ứng (app.config.ts).
EXPO_PUBLIC_ENV=dev
# DEV is remote-first: this points at the deployed dev API, not a backend on
# your machine. Running GoGo-BE, PostgreSQL and Redis locally is not required
# and not expected (GoGo-Infra INF-038).
#
# Override it only to test against a backend you are changing yourself.
EXPO_PUBLIC_API_URL=https://api-dev.gogo.id.vn/v1

# Required public build configuration in dev/stag/prod; generated from Infra.
ONESIGNAL_APP_ID=
ONESIGNAL_CONFIG_ENV=dev
# Signing channel: TestFlight uses production even when CONFIG_ENV is dev.
ONESIGNAL_APNS_MODE=development
# The share-link host for this environment, served by the gogo-dev-share-link
# Worker: /l/{slug} resolves and redirects, and /.well-known/* carries the app
# association files.
#
# gogo.app is not a domain this project owns, so a link built against it can
# never verify. The owned domain is gogo.id.vn; dev's share host is
# go-dev.gogo.id.vn.
EXPO_PUBLIC_WEB_BASE_URL=https://go-dev.gogo.id.vn
# Google Maps SDK for iOS key (APP-040, ADR 0005). Read once, at prebuild, by
# Expo's react-native-maps plugin — never by JavaScript, which is why it is not
# EXPO_PUBLIC_. Leave it empty for Apple Maps. The real value comes from
# GoGo-Infra (INF-055): a client key restricted to this app's bundle ids and to
# the Maps SDK for iOS only. After changing it, the binary has to be rebuilt:
#   npx expo prebuild --platform ios && pnpm ios
GOOGLE_MAPS_IOS_API_KEY=
